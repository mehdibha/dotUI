  "https://www.duolingo.com/learn": {
    "signedIn": true,
    "settle": 4000,
    "steps": [
      {
        "press": "Escape"
      }
    ],
    "parts": {
      "shell": {
        "selector": "div:has(> div > div > [data-test=home-nav])"
      },
      "nav.item": {
        "selector": "[data-test=shop-nav] > span",
        "ink": ":scope > span:last-child",
        "skip": ["borderRadius"]
      },
      "nav.item.active": {
        "selector": "[data-test=home-nav] > span",
        "ink": ":scope > span:last-child"
      },
      "tooltip": {
        "selector": "[data-test=skill-path-tooltip-unit-test] > div",
        "skip": ["color"]
      },
      "menu": {
        "selector": "[data-test=more-nav] div[style*=fixed] > div",
        "before": [
          {
            "hover": "[data-test=more-nav]"
          },
          {
            "wait": "[data-test=settings-button]"
          }
        ],
        "skip": ["color"]
      },
      "menu.item": {
        "selector": "[data-test=settings-button]",
        "ink": ":scope > span",
        "before": [
          {
            "hover": "[data-test=more-nav]"
          },
          {
            "wait": "[data-test=settings-button]"
          }
        ]
      }
    },
    "blocks": {
      "side-nav": {
        "selector": "div:has(> a[data-test=home-nav])"
      },
      "unit-banner": {
        "selector": "[data-test=guidebook-button-1]",
        "surface": true
      },
      "path-unit": {
        "selector": "[data-test=skill-path-unit-0]"
      },
      "footer-links": {
        "selector": "[data-test=footer-links]"
      }
    }
  },
