{
  "https://www.airbnb.com/": {
    "mode": "light",
    "settle": 4000,
    "parts": {
      "page": {
        "selector": "body"
      },
      "tab": {
        "selector": "a[role=tab][aria-selected=false] span[data-tab-label]",
        "skip": ["borderRadius", "height", "paddingInline"]
      },
      "tab.selected": {
        "selector": "a[role=tab][aria-selected=true] span[data-tab-label]",
        "skip": ["borderRadius", "height", "paddingInline"]
      },
      "button.quiet": {
        "text": "Become a host",
        "skip": ["borderRadius"]
      },
      "button.icon": {
        "selector": "button[data-testid=cypress-headernav-profile]"
      },
      "menu": {
        "selector": "[data-testid=guest-header-dropdownmenu]",
        "surface": true,
        "before": [
          {
            "focus": "button[data-testid=cypress-headernav-profile]"
          },
          {
            "press": "Enter"
          }
        ]
      },
      "menu.item": {
        "within": "[data-testid=guest-header-dropdownmenu]",
        "text": "Help Center",
        "before": [
          {
            "focus": "button[data-testid=cypress-headernav-profile]"
          },
          {
            "press": "Enter"
          }
        ]
      },
      "input": {
        "selector": "[role=dialog] div:has(> label input)",
        "ink": "input",
        "before": [
          {
            "focus": "button[aria-label='Log in or sign up']"
          },
          {
            "press": "Enter"
          }
        ],
        "skip": ["paddingInline", "boxShadow"]
      },
      "input.focus": {
        "selector": "[role=dialog] div:has(> label input)",
        "before": [
          {
            "focus": "button[aria-label='Log in or sign up']"
          },
          {
            "press": "Enter"
          },
          {
            "focus": "[role=dialog] input"
          }
        ]
      },
      "segmented": {
        "selector": "div:has(> [role=tablist] > [data-testid=expanded-searchbar-dates-calendar-tab])",
        "before": [
          {
            "click": "[role=search] [role=button]"
          }
        ]
      },
      "segmented.item": {
        "selector": "[data-testid=expanded-searchbar-dates-flexible-tab]",
        "before": [
          {
            "click": "[role=search] [role=button]"
          }
        ]
      },
      "segmented.selected": {
        "selector": "[data-testid=expanded-searchbar-dates-calendar-tab]",
        "before": [
          {
            "click": "[role=search] [role=button]"
          }
        ]
      }
    }
  },
  "https://www.airbnb.com/s/Paris/homes": {
    "mode": "light",
    "settle": 4000,
    "parts": {
      "pagination.current": {
        "selector": "nav[aria-label='Search results pagination'] [aria-current=page]"
      },
      "button.primary": {
        "within": "[role=dialog][aria-label=Filters]",
        "selector": "a",
        "text": "Show 1,000+ places",
        "before": [
          {
            "focus": "button[aria-label=Filters]"
          },
          {
            "press": "Enter"
          }
        ]
      },
      "dialog": {
        "selector": "[role=dialog][aria-label=Filters]",
        "surface": true,
        "before": [
          {
            "focus": "button[aria-label=Filters]"
          },
          {
            "press": "Enter"
          }
        ],
        "skip": ["edge"]
      },
      "toggle": {
        "selector": "[role=dialog][aria-label=Filters] #filter-item-amenities-4",
        "before": [
          {
            "focus": "button[aria-label=Filters]"
          },
          {
            "press": "Enter"
          }
        ]
      },
      "toggle.on": {
        "selector": "[role=dialog][aria-label=Filters] #filter-item-amenities-4[aria-pressed=true]",
        "before": [
          {
            "focus": "button[aria-label=Filters]"
          },
          {
            "press": "Enter"
          },
          {
            "click": "#filter-item-amenities-4"
          }
        ]
      },
      "badge": {
        "text": "Free cancellation"
      }
    }
  },
  "https://www.airbnb.com/rooms/47803806": {
    "mode": "light",
    "settle": 4000,
    "parts": {
      "button.secondary": {
        "text": "Show all 50 amenities",
        "skip": ["height", "paddingInline", "fontSize"]
      },
      "button.focus": {
        "text": "Show all 50 amenities",
        "focus": true
      },
      "card": {
        "selector": "aside:has([data-testid=book-it-default])",
        "skip": ["backgroundColor"]
      },
      "calendar.day": {
        "selector": "[data-testid^=calendar-day-][data-is-day-blocked=false]"
      },
      "heading.3": {
        "selector": "main h1",
        "skip": ["fontSize"]
      },
      "heading.4": {
        "text": "What this place offers",
        "skip": ["fontSize"]
      },
      "text": {
        "selector": "[data-section-id=DESCRIPTION_DEFAULT] span > span"
      },
      "text.muted": {
        "text": "Add your travel dates for exact pricing"
      }
    }
  },
  "https://www.airbnb.com/host/homes": {
    "mode": "light",
    "settle": 4000,
    "parts": {
      "link": {
        "selector": "a",
        "text": "Learn more"
      }
    }
  },
  "https://www.airbnb.com/account-settings": {
    "signedIn": true,
    "mode": "light",
    "settle": 4000,
    "parts": {
      "heading.1": {
        "selector": "h1 > span",
        "skip": ["fontSize"]
      },
      "badge.accent": {
        "selector": "a[href='/account-settings/preferences'] span > div"
      },
      "nav.item": {
        "selector": "a[href='/account-settings/login-and-security'] > div > div",
        "skip": ["borderRadius"]
      },
      "nav.item.active": {
        "selector": "div:has(> a[aria-current=page][href^='/account-settings'])",
        "ink": "a > div > div",
        "skip": ["paddingInline"]
      }
    }
  },
  "https://www.airbnb.com/account-settings/privacy-and-sharing": {
    "signedIn": true,
    "mode": "light",
    "settle": 4000,
    "steps": [
      {
        "press": "Escape"
      }
    ],
    "parts": {
      "heading.2": {
        "selector": "h3",
        "skip": ["fontSize"]
      },
      "switch.on": {
        "selector": "[role=switch][aria-checked=true]"
      },
      "radio": {
        "selector": "[role=dialog] input[type=radio]:not(:checked)",
        "before": [
          {
            "click": "button::-p-text(Choose who can see your profile)"
          },
          {
            "wait": "[role=dialog] input[type=radio]"
          }
        ]
      },
      "radio.checked": {
        "selector": "[role=dialog] input[type=radio]:checked",
        "before": [
          {
            "click": "button::-p-text(Choose who can see your profile)"
          },
          {
            "wait": "[role=dialog] input[type=radio]"
          }
        ],
        "skip": ["edge"]
      }
    }
  },
  "https://www.airbnb.com/account-settings/notifications": {
    "signedIn": true,
    "mode": "light",
    "settle": 4000,
    "parts": {
      "switch.off": {
        "selector": "[role=dialog] [role=switch][aria-checked=false]",
        "before": [
          {
            "click": "button[aria-label='Edit Recognition and achievements']"
          },
          {
            "wait": "[role=dialog] [role=switch]"
          }
        ]
      },
      "checkbox": {
        "selector": "span:has(> input[type=checkbox]) > span"
      }
    }
  }
}
