{
  "https://www.headspace.com/login": {
    "mode": "light",
    "settle": 3000,
    "parts": {
      "input": {
        "selector": "[data-testid=text-input-field]",
        "ink": "input"
      },
      "input.focus": {
        "selector": "[data-testid=text-input-field]",
        "before": [
          {
            "focus": "input[name=username]"
          }
        ],
        "only": ["edge"]
      },
      "button.primary": {
        "selector": "button[type=submit][data-testid=button]"
      },
      "link": {
        "text": "Sign up for free"
      },
      "button.focus": {
        "selector": "button[type=submit][data-testid=button]",
        "focus": true
      }
    }
  },
  "https://www.headspace.com/": {
    "mode": "light",
    "settle": 3000,
    "steps": [
      {
        "click": "#onetrust-reject-all-handler"
      }
    ],
    "parts": {
      "page": {
        "selector": "body",
        "skip": ["color"]
      },
      "toggle": {
        "selector": "[data-testid=deeper-dive-tabs-link-1]"
      },
      "toggle.on": {
        "selector": "[data-testid=deeper-dive-tabs-link-0-active]"
      },
      "heading.1": {
        "selector": "[data-testid=quotes-title]",
        "skip": ["fontSize"]
      },
      "heading.2": {
        "selector": "[data-testid=accordion-module-title]",
        "skip": ["fontSize"]
      },
      "heading.3": {
        "selector": "[data-testid=need-state-container-title]",
        "skip": ["fontSize"]
      }
    }
  },
  "https://www.headspace.com/app": {
    "mode": "light",
    "settle": 3000,
    "steps": [
      {
        "click": "#onetrust-reject-all-handler"
      }
    ],
    "parts": {
      "card": {
        "selector": ".threeCard"
      }
    }
  },
  "https://www.headspace.com/sleep": {
    "mode": "light",
    "settle": 3000,
    "steps": [
      {
        "click": "#onetrust-reject-all-handler"
      }
    ],
    "parts": {
      "pagination.current": {
        "within": "[data-testid=article-grid-pagination]",
        "selector": "button[disabled]",
        "text": "1"
      }
    }
  },
  "https://www.headspace.com/subscriptions": {
    "mode": "light",
    "settle": 3000,
    "steps": [
      {
        "click": "#onetrust-reject-all-handler"
      }
    ],
    "parts": {
      "badge.accent": {
        "selector": "[data-testid=subscription-plan-tag-text]"
      }
    }
  },
  "https://www.headspace.com/content/meditation/youre-worthy-of-love/7976": {
    "mode": "light",
    "settle": 3000,
    "steps": [
      {
        "click": "#onetrust-reject-all-handler"
      }
    ],
    "parts": {
      "button.secondary": {
        "selector": "button[data-testid=button]",
        "text": "Play Sample"
      },
      "text": {
        "selector": "[data-testid=media-banner-content]",
        "skip": ["color"]
      },
      "heading.4": {
        "selector": "h1[data-testid=content-hero-contentTitle]",
        "skip": ["fontSize", "color"]
      }
    }
  },
