        "selector": "#search-home-form-combo-menu .search-home-input-autocomplete-terms-part:not(.search-home-input-autocomplete-terms-part--is-highlighted)"
      }
    }
  },
  "https://www.zara.com/us/en/logon": {
    "signedIn": true,
    "mode": "light",
    "settle": 3000,
    "parts": {
      "input": {
        "selector": "label.mds-base-field__control",
        "ink": "input"
      },
      "input.focus": {
        "selector": "label.mds-base-field__control",
        "ink": "input",
