  },
  "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:light&id=components-textinput--default": {
    "dark": "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:dark&id=components-textinput--default",
    "parts": {
      "input.focus": {
        "selector": "[data-component=TextInput]",
        "focus": true
      },
      "field.label": {
        "selector": "label",
        "only": ["color", "fontSize", "fontWeight"]
      }
    }
  },
  "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:light&id=components-select--default": {
    "dark": "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:dark&id=components-select--default",
    "parts": {
      "select.trigger": {
        "selector": "[data-component=TextInput]",
        "skip": ["letterSpacing", "paddingInline"]
      }
    }
  },
  "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:light&id=components-checkbox--default": {
    "dark": "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:dark&id=components-checkbox--default",
    "parts": {
      "checkbox": {
        "selector": "input[type=checkbox]",
        "only": ["backgroundColor", "borderRadius", "height", "edge"]
      },
      "checkbox.checked": {
        "selector": "input[type=checkbox]",
        "before": [
          {
            "click": "input[type=checkbox]"
          }
        ],
        "only": ["backgroundColor", "borderRadius", "height"]
      }
    }
  },
  "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:light&id=components-toggleswitch--default": {
    "dark": "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:dark&id=components-toggleswitch--default",
    "parts": {
      "switch.off": {
        "selector": "button[aria-pressed]",
        "only": ["backgroundColor", "borderRadius", "height", "edge"]
      }
    }
  },
  "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:light&id=components-toggleswitch-features--checked": {
    "dark": "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:dark&id=components-toggleswitch-features--checked",
    "parts": {
      "switch.on": {
        "selector": "button[aria-pressed]",
        "only": ["backgroundColor", "borderRadius", "height", "edge"]
      }
    }
  },
  "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:light&id=components-tooltipv2--default": {
    "dark": "https://primer.style/react/storybook/iframe.html?viewMode=story&globals=colorScheme:dark&id=components-tooltipv2--default",
    "parts": {
