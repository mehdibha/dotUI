{
  "name": "MessageProps",
  "description": "One turn in a conversation — lays out the avatar and the content column on\none side of the thread.",
  "extendsElement": "div",
  "props": {
    "align": {
      "type": "\"end\" | \"start\"",
      "detailedType": "'end' | 'start' | undefined",
      "typeAst": {
        "type": "union",
        "elements": [
          {
            "type": "stringLiteral",
            "value": "end"
          },
          {
            "type": "stringLiteral",
            "value": "start"
          }
        ]
      },
      "description": "Which side of the conversation the message sits on. `end` flips the row,\nputting the avatar after the content.",
      "default": "'start'"
    },
    "className": {
      "type": "string",
      "typeAst": {
        "type": "string"
      },
      "description": "The CSS [className](https://developer.mozilla.org/en-US/docs/Web/API/Element/className) for the element."
    }
  }
}
