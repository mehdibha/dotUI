{
  "name": "PieRingOptions",
  "description": "One ring of slices — its arcs, the active slice, and the slice labels — to\npass as a pie chart's `marks`. Radii are shares of the chart radius, not\npixels.",
  "props": {
    "value": {
      "type": "string",
      "typeAst": {
        "type": "string"
      },
      "description": "Field holding the slice size.",
      "required": true
    },
    "name": {
      "type": "string",
      "typeAst": {
        "type": "string"
      },
      "description": "Field naming each slice — its color and its legend entry.",
      "required": true
    },
    "labels": {
      "type": "Readonly<Record<string, string>>",
      "detailedType": "Readonly<Record<string, string>> | undefined",
      "typeAst": {
        "type": "union",
        "elements": [
          {
            "type": "undefined"
          },
          {
            "type": "application",
            "base": {
              "type": "identifier",
              "name": "Readonly"
            },
            "typeParameters": [
              {
                "type": "application",
                "base": {
                  "type": "identifier",
                  "name": "Record"
                },
                "typeParameters": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            ]
          }
        ]
      },
      "description": "Display names for slice keys, read by the legend, labels, and tooltip."
    },
    "id": {
      "type": "string",
      "detailedType": "string | undefined",
      "typeAst": {
        "type": "string"
      },
      "description": "Scopes the ring's mark ids — unique per ring when a chart draws several.",
      "default": "\"pie\""
    },
    "innerRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Hole radius, as a share of the chart radius. Above 0 it is a donut.",
      "default": "0"
    },
    "outerRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Outer radius, as a share of the chart radius.",
      "default": "1"
    },
    "startAngle": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Angle the first slice starts at, in radians clockwise from twelve o'clock.",
      "default": "0"
    },
    "endAngle": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Angle the last slice ends at, in radians. `Math.PI` draws a semicircle.",
      "default": "2 * Math.PI"
    },
    "padAngle": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Gap between slices, in radians.",
      "default": "0"
    },
    "cornerRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Corner rounding of each slice, in pixels.",
      "default": "0"
    },
    "stroke": {
      "type": "string",
      "detailedType": "string | undefined",
      "typeAst": {
        "type": "string"
      },
      "description": "The line between slices.",
      "default": "\"var(--surface-bg,var(--color-bg))\""
    },
    "strokeWidth": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Width of that line, in pixels. `0` lets the slices touch.",
      "default": "2"
    },
    "activeIndex": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Index of a slice pushed out of the ring, to call it out."
    },
    "activeOffset": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "How far the active slice grows, as a share of the radius.",
      "default": "0.08"
    },
    "sliceLabel": {
      "type": "\"name\" | \"value\"",
      "detailedType": "'name' | 'value' | undefined",
      "typeAst": {
        "type": "union",
        "elements": [
          {
            "type": "stringLiteral",
            "value": "name"
          },
          {
            "type": "stringLiteral",
            "value": "value"
          }
        ]
      },
      "description": "Text drawn on each slice: its name or its value."
    },
    "sliceLabelRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Where slice labels sit, as a share of the radius. Defaults to the middle\nof the ring."
    },
    "sliceLabelFill": {
      "type": "string",
      "detailedType": "string | undefined",
      "typeAst": {
        "type": "string"
      },
      "description": "Slice label color.",
      "default": "\"var(--color-fg)\""
    },
    "sliceLabelFontSize": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Slice label size, in pixels.",
      "default": "12"
    },
    "formatValue": {
      "type": "((value: ChartValue) => string)",
      "detailedType": "((value: ChartValue) => string) | undefined",
      "typeAst": {
        "type": "function",
        "parameters": [
          {
            "type": "parameter",
            "name": "value",
            "value": {
              "type": "link",
              "id": "ChartValue",
              "name": "ChartValue"
            },
            "optional": false,
            "rest": false
          }
        ],
        "return": {
          "type": "string"
        },
        "typeParameters": []
      },
      "description": "Formats slice values in labels and the tooltip."
    }
  }
}
