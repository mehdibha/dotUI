  "extendsElement": "div",
  "props": {
    "state": {
      "type": "\"done\" | \"error\" | \"idle\" | \"processing\" | \"uploading\"",
      "detailedType": "| 'done'\n| 'error'\n| 'idle'\n| 'processing'\n| 'uploading'\n| undefined",
      "typeAst": {
        "type": "union",
        "elements": [
          {
            "type": "stringLiteral",
            "value": "done"
          },
          {
            "type": "stringLiteral",
            "value": "error"
          },
          {
            "type": "stringLiteral",
            "value": "idle"
          },
          {
            "type": "stringLiteral",
            "value": "processing"
          },
          {
            "type": "stringLiteral",
            "value": "uploading"
          }
        ]
      },
      "description": "Where the file is in its lifecycle. `idle` renders a dashed outline,\n`uploading` and `processing` pulse the title, `error` renders the danger\ntreatment.",
