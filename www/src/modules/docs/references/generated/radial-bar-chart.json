{
  "name": "RadialBarChartProps",
  "description": "Radial bar chart. Give it rows, the field holding each value, and the field\nnaming it. Angles are radians and radii are ratios of the circle the chart\nresolves for its box. Interaction and animation props are shared by every\nfamily — see `ChartBehaviorProps` — and the host props (`height`, `width`,\n`className`, callbacks) live on `Chart`.",
  "props": {
    "ariaLabel": {
      "type": "string",
      "typeAst": {
        "type": "string"
      },
      "description": "Accessible name. Required: a chart is a figure, not decoration.",
      "required": true
    },
    "barLabelFill": {
      "type": "string",
      "detailedType": "string | undefined",
      "typeAst": {
        "type": "string"
      },
      "description": "Fill of the ring labels."
    },
    "barLabelFontSize": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Font size of the ring labels.",
      "default": "11"
    },
    "barLabels": {
      "type": "boolean",
      "detailedType": "boolean | undefined",
      "typeAst": {
        "type": "boolean"
      },
      "description": "Print each ring's name at the start of its arc.",
      "default": "false"
    },
    "barPadding": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Gap between rings, as a share of a ring's thickness. In stacked mode\n(array `value`) it becomes a per-segment radial inset instead.",
      "default": "0.2 — 0.04 in stacked mode"
    },
    "children": {
      "type": "ReactNode",
      "typeAst": {
        "type": "identifier",
        "name": "ReactNode"
      },
