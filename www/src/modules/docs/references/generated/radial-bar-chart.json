      "default": "4"
    },
    "innerRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Inner edge of the innermost ring, as a ratio of the radius.",
      "default": "0.35"
    },
    "inset": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
