      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Corner radius of each arc, in pixels. A large value gives pill ends.",
      "default": "4"
    },
    "data": {
      "type": "readonly unknown[]",
      "typeAst": {
        "type": "array",
        "elementType": {
          "type": "unknown"
        }
      },
      "description": "The rows to plot. Compared by identity — define it outside render.",
      "required": true
