{
  "name": "PieChartProps",
  "description": "Pie and donut chart. One row per slice: `value` names the field holding the\nmagnitude, `name` the field holding the slice key. Radii are ratios of the\nchart's resolved radius, not pixels, so a pie keeps its proportions at every\nsize. Interaction and animation props are shared by every family — see\n`ChartBehaviorProps` — and the host props (`height`, `className`, callbacks)\nlive on `Chart`.",
  "props": {
    "activeIndex": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Index of a slice pushed out of the ring, to call it out."
    },
    "activeOffset": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "How far that slice is pushed out, as a ratio of the radius.",
      "default": "0.08"
    },
    "ariaLabel": {
      "type": "string",
      "typeAst": {
        "type": "string"
      },
      "description": "Accessible name. Required: a chart is a figure, not decoration.",
      "required": true
    },
    "children": {
      "type": "ReactNode",
      "typeAst": {
        "type": "identifier",
        "name": "ReactNode"
      },
      "description": "Overlay rendered above the chart surface, ignoring pointer events."
    },
    "cornerRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Corner rounding of each slice, in pixels.",
      "default": "0"
    },
    "data": {
      "type": "readonly unknown[]",
      "typeAst": {
        "type": "array",
        "elementType": {
          "type": "unknown"
        }
      },
      "description": "The rows to plot, one per slice. Compared by identity — define it outside render.",
      "required": true
    },
    "endAngle": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Angle the last slice ends at, in radians. A half turn draws a semicircle.",
      "default": "2 * Math.PI"
    },
    "innerRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Inner radius, as a ratio of the outer edge. Above 0 it is a donut.",
      "default": "0"
    },
    "inset": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Pixel inset applied before `radiusRatio`."
    },
    "labels": {
      "type": "Readonly<Record<string, string>>",
      "detailedType": "Readonly<Record<string, string>> | undefined",
      "typeAst": {
        "type": "union",
        "elements": [
          {
            "type": "undefined"
          },
          {
            "type": "application",
            "base": {
              "type": "identifier",
              "name": "Readonly"
            },
