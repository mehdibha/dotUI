                {
                  "type": "any"
                },
                {
                  "type": "any"
                },
                {
                  "type": "any"
                }
              ]
            }
          }
        ]
      },
      "description": "Extra polar mark layers, spliced inside the polar container — a second\n`pieRing`, an annotation arc. Define them outside render."
    },
    "radiusRatio": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Share of the available radius the ring may use — leave room for labels.",
      "default": "0.9"
    },
    "seriesOrder": {
      "type": "readonly string[]",
      "detailedType": "readonly string[] | undefined",
      "typeAst": {
