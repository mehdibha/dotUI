              {
                "type": "application",
                "base": {
                  "type": "identifier",
                  "name": "Record"
                },
                "typeParameters": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            ]
          }
        ]
      },
      "description": "Display names for slice keys, used by the legend, labels, and tooltip."
    },
    "legend": {
      "type": "boolean",
      "detailedType": "boolean | undefined",
      "typeAst": {
        "type": "boolean"
      },
      "description": "Show the color legend. Off by default: a pie usually names its slices with\nlabels or the tooltip.",
      "default": "false"
    },
    "name": {
      "type": "string",
      "typeAst": {
        "type": "string"
      },
      "description": "Field holding the slice key.",
      "required": true
    },
    "outerRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Outer radius, as a ratio of the available radius.",
      "default": "1"
    },
    "padAngle": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Gap between slices, in radians.",
      "default": "0"
    },
    "polarMarks": {
      "type": "readonly PolarMarkLayer[]",
      "detailedType": "readonly PolarMarkLayer[] | undefined",
      "typeAst": {
        "type": "union",
