    },
    "sliceLabel": {
      "type": "\"name\" | \"none\" | \"value\"",
      "detailedType": "'name' | 'none' | 'value' | undefined",
      "typeAst": {
        "type": "union",
        "elements": [
          {
            "type": "stringLiteral",
            "value": "name"
          },
          {
            "type": "stringLiteral",
            "value": "none"
          },
          {
            "type": "stringLiteral",
            "value": "value"
          }
        ]
      },
      "description": "Text drawn on each slice: its key, its value, or nothing.",
      "default": "\"none\""
    },
    "sliceLabelFill": {
      "type": "string",
      "detailedType": "string | undefined",
      "typeAst": {
        "type": "string"
      },
      "description": "Label color.",
      "default": "\"var(--color-fg)\""
    },
    "sliceLabelFontSize": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Label size in pixels.",
      "default": "12"
    },
    "sliceLabelRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Radius the labels sit at, as a ratio. Defaults to the middle of the ring."
    },
    "startAngle": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Angle the first slice starts at, in radians, clockwise from twelve o'clock.",
      "default": "0"
    },
    "stroke": {
      "type": "string",
      "detailedType": "string | undefined",
      "typeAst": {
        "type": "string"
      },
      "description": "Stroke painted between slices — set it to the page background to separate them."
    },
    "strokeWidth": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Width of that stroke, in pixels."
    },
    "value": {
      "type": "string",
      "typeAst": {
        "type": "string"
      },
      "description": "Field holding the slice magnitude.",
      "required": true
    }
  },
