{
  "name": "RadialChartOptions",
  "description": "Builds a complete radial bar chart for `defineChart`. Give it rows, the\nfield holding each value, and the field naming each ring. Angles are\nradians; radii are shares of the chart radius.",
  "props": {
    "value": {
      "type": "readonly string[] | string",
      "typeAst": {
        "type": "union",
        "elements": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "elementType": {
              "type": "string"
            }
          }
        ]
      },
      "description": "The value field: one ring per row, innermost first. Several fields stack\nthe first row's values around one ring.",
      "required": true
    },
    "name": {
      "type": "string",
      "typeAst": {
        "type": "string"
      },
      "description": "Field naming each ring.",
      "required": true
    },
    "labels": {
      "type": "Readonly<Record<string, string>>",
      "detailedType": "Readonly<Record<string, string>> | undefined",
      "typeAst": {
        "type": "union",
        "elements": [
          {
            "type": "undefined"
          },
          {
            "type": "application",
            "base": {
              "type": "identifier",
              "name": "Readonly"
            },
            "typeParameters": [
              {
                "type": "application",
                "base": {
                  "type": "identifier",
                  "name": "Record"
                },
                "typeParameters": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            ]
          }
        ]
      },
      "description": "Display names for ring keys and stacked fields, read by the legend and the tooltip."
    },
    "startAngle": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Start of the sweep, in radians clockwise from twelve o'clock.",
      "default": "0"
    },
    "endAngle": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "End of the sweep, in radians.",
      "default": "Math.PI * 2"
    },
    "innerRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Inner edge of the innermost ring, as a share of the chart radius.",
      "default": "0.35"
    },
    "outerRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Outer edge of the outermost ring, as a share of the chart radius.",
      "default": "1"
    },
    "radiusRatio": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Share of the available radius the chart fills.",
      "default": "1"
    },
    "inset": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Pixels kept clear around the chart.",
      "default": "0"
    },
    "barPadding": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Gap between rings, as a share of a ring's thickness.",
      "default": "0.2"
    },
    "cornerRadius": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Corner radius of each arc, in pixels. A large value gives pill ends.",
      "default": "4"
    },
    "track": {
      "type": "boolean",
      "detailedType": "boolean | undefined",
      "typeAst": {
        "type": "boolean"
      },
      "description": "An unfilled arc behind every ring, spanning the whole sweep. Not drawn\nwhen `value` lists several fields.",
      "default": "false"
    },
    "trackFill": {
      "type": "string",
      "detailedType": "string | undefined",
      "typeAst": {
        "type": "string"
      },
      "description": "Fill of the track.",
      "default": "\"var(--color-muted)\""
    },
    "max": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "The value that fills the whole sweep. Defaults to the largest value, or the stack's total."
    },
    "barLabels": {
      "type": "boolean",
      "detailedType": "boolean | undefined",
      "typeAst": {
        "type": "boolean"
      },
      "description": "Each ring's name at the start of its arc. Not drawn when `value` lists\nseveral fields.",
      "default": "false"
    },
    "barLabelFill": {
      "type": "string",
      "detailedType": "string | undefined",
      "typeAst": {
        "type": "string"
      },
      "description": "Fill of the ring names.",
      "default": "\"var(--color-fg)\""
    },
    "barLabelFontSize": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Font size of the ring names.",
      "default": "11"
    },
    "grid": {
      "type": "boolean",
      "detailedType": "boolean | undefined",
      "typeAst": {
        "type": "boolean"
      },
      "description": "Concentric gridlines behind the rings.",
      "default": "false"
    },
    "gridTicks": {
      "type": "number",
      "detailedType": "number | undefined",
      "typeAst": {
        "type": "number"
      },
      "description": "Approximate number of gridlines.",
      "default": "4"
    },
    "legend": {
      "type": "boolean",
      "detailedType": "boolean | undefined",
      "typeAst": {
        "type": "boolean"
      },
      "description": "A color legend below the chart.",
      "default": "false"
    },
    "formatValue": {
      "type": "((value: ChartValue) => string)",
      "detailedType": "((value: ChartValue) => string) | undefined",
      "typeAst": {
        "type": "function",
        "parameters": [
          {
            "type": "parameter",
            "name": "value",
            "value": {
              "type": "link",
              "id": "ChartValue",
              "name": "ChartValue"
            },
            "optional": false,
            "rest": false
          }
        ],
        "return": {
          "type": "string"
        },
        "typeParameters": []
      },
      "description": "Formats values in the tooltip."
    },
    "marks": {
      "type": "readonly PolarMark<unknown, ChartValue, ChartValue, \"angle\", \"radius\">[]",
      "detailedType": "| readonly PolarMark<\n    unknown,\n    ChartValue,\n    ChartValue,\n    'angle',\n    'radius'\n  >[]\n| undefined",
      "typeAst": {
        "type": "union",
        "elements": [
          {
            "type": "undefined"
          },
          {
            "type": "array",
            "elementType": {
              "type": "link",
              "id": "@tanstack/charts/dist/polar.d.ts:PolarMark",
              "name": "PolarMark"
            }
          }
        ]
      },
      "description": "More polar layers drawn over the rings. They share the chart's scales:\nangles are values, radii are ring names."
    }
