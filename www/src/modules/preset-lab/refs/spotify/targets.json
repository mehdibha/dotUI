{
  "encore.html": {
    "parts": {
      "page": {
        "selector": "body"
      },
      "button.primary": {
        "selector": "[data-part=\"button.primary\"]"
      },
      "button.secondary": {
        "selector": "[data-part=\"button.secondary\"]"
      },
      "button.quiet": {
        "selector": "[data-part=\"button.quiet\"]"
      },
      "button.focus": {
        "selector": "[data-part=\"button.focus\"]",
        "focus": true,
        "skip": ["edge"]
      },
      "checkbox": {
        "selector": "[data-part=\"checkbox\"]"
      },
      "checkbox.checked": {
        "selector": "[data-part=\"checkbox.checked\"]"
      },
      "radio": {
        "selector": "[data-part=\"radio\"]"
      },
      "radio.checked": {
        "selector": "[data-part=\"radio.checked\"]"
      },
      "switch.off": {
        "selector": "[data-part=\"switch.off\"]"
      },
      "switch.on": {
        "selector": "[data-part=\"switch.on\"]"
      },
      "field.label": {
        "selector": "[data-part=\"field.label\"]"
      },
      "input": {
        "selector": "[data-part=\"input\"]",
        "skip": ["boxShadow"]
      },
      "input.focus": {
        "selector": "[data-part=\"input.focus\"]",
        "focus": true
      },
      "tab.selected": {
        "selector": "[data-part=\"tab.selected\"]",
        "skip": ["fontSize", "borderRadius"]
      },
      "tab": {
        "selector": "[data-part=\"tab\"]",
        "skip": ["fontSize", "borderRadius"]
      },
      "link": {
        "selector": "[data-part=\"link\"]"
      },
      "alert": {
        "selector": "[data-part=\"alert\"]"
      },
      "badge": {
        "selector": "[data-part=\"badge\"]",
        "skip": ["fontSize", "fontWeight"]
      },
      "badge.accent": {
        "selector": "[data-part=\"badge.accent\"]",
        "skip": ["fontSize", "fontWeight"]
      },
      "progress": {
        "selector": "[data-part=\"progress\"]"
      },
      "progress.fill": {
        "selector": "[data-part=\"progress.fill\"]"
      },
      "heading.1": {
        "selector": "[data-part=\"heading.1\"]",
        "skip": ["fontSize"]
      },
      "heading.3": {
        "selector": "[data-part=\"heading.3\"]",
        "skip": ["fontSize"]
      },
      "text": {
        "selector": "[data-part=\"text\"]"
      },
      "text.muted": {
        "selector": "[data-part=\"text.muted\"]",
        "skip": ["fontSize"]
      },
      "tooltip": {
        "selector": "[data-part=\"tooltip\"]",
        "skip": ["boxShadow", "height", "fontSize"]
      },
      "menu": {
        "selector": "[data-part=\"menu\"]",
        "skip": ["boxShadow"]
      }
    }
  },
  "https://open.spotify.com/": {
    "signedIn": true,
    "mode": "dark",
    "parts": {
      "shell": {
        "selector": ".Root__top-container",
        "surface": true
      },
      "panel": {
        "selector": ".Root__main-view"
      },
      "nav.item": {
        "within": "#Desktop_LeftSidebar_Id",
        "selector": "[role=row]"
      },
      "toggle": {
        "within": ".Root__main-view",
        "selector": "button[role=checkbox][aria-checked=false]"
      },
      "toggle.on": {
        "within": ".Root__main-view",
        "selector": "button[role=checkbox][aria-checked=true]"
      },
      "card": {
        "within": ".Root__main-view",
        "selector": "[data-encore-id=card]"
      },
      "button.icon": {
        "selector": "[data-testid=control-button-skip-back]"
      },
      "menu.item": {
        "selector": "#context-menu [role=menuitem]",
        "before": [
          {
            "click": "[data-testid=user-widget-link]"
          }
        ]
      },
      "dialog": {
        "selector": "[role=dialog]",
        "surface": true,
        "before": [
          {
            "press": "Control+/"
          }
        ]
      },
      "search": {
        "selector": "[data-testid=search-input]"
      },
      "slider": {
        "selector": "[data-testid=playback-progressbar] [data-testid=progress-bar-background]"
      },
      "menu.player": {
        "selector": "#context-menu",
        "surface": true,
        "before": [
          {
            "click": "[data-testid=user-widget-link]"
          }
        ]
      }
    }
  }
}
