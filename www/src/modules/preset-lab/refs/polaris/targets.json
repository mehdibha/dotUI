{
  "react.html?sheet=actions&theme=light": {
    "mode": "light",
    "parts": {
      "page": {
        "selector": "body"
      },
      "button.primary": {
        "within": "[data-part=button-primary]",
        "selector": "button",
        "ink": ".Polaris-Text--root",
        "skip": ["fontFamily", "letterSpacing"]
      },
      "button.secondary": {
        "within": "[data-part=button-secondary]",
        "selector": "button",
        "ink": ".Polaris-Text--root",
        "skip": ["fontFamily", "letterSpacing"]
      },
      "button.quiet": {
        "within": "[data-part=button-quiet]",
        "selector": "button",
        "ink": ".Polaris-Text--root",
        "only": [
          "color",
          "borderRadius",
          "height",
          "paddingInline",
          "fontSize",
          "fontWeight",
          "edge"
        ]
      },
      "button.focus": {
        "within": "[data-part=button-focus]",
        "selector": "button",
        "focus": true,
        "only": ["ring"]
      },
      "kbd": {
        "within": "[data-part=kbd-small]",
        "selector": ".Polaris-KeyboardKey",
        "skip": ["fontFamily", "letterSpacing", "boxShadow"]
      }
    }
  },
  "react.html?sheet=fields&theme=light": {
    "mode": "light",
    "parts": {
      "input": {
        "within": "[data-part=input]",
        "selector": ".Polaris-TextField",
        "box": ".Polaris-TextField__Backdrop",
        "ink": "input",
        "only": [
          "backgroundColor",
          "color",
          "borderRadius",
          "height",
          "fontSize",
          "fontWeight",
          "edge"
        ]
      },
      "input.focus": {
        "selector": "[data-specimen-focus]",
        "only": ["backgroundColor", "edge", "ring"],
        "focus": true
      },
      "select.trigger": {
        "within": "[data-part=select]",
        "selector": ".Polaris-Select",
        "box": ".Polaris-Select__Backdrop",
        "ink": ".Polaris-Select__SelectedOption",
        "only": [
          "backgroundColor",
          "color",
          "borderRadius",
          "height",
          "fontSize",
          "fontWeight",
          "edge"
        ]
      }
    }
  },
  "react.html?sheet=selection&theme=light": {
    "mode": "light",
    "parts": {
      "checkbox": {
        "within": "[data-part=checkbox]",
        "selector": ".Polaris-Checkbox__Backdrop"
      },
      "checkbox.checked": {
        "within": "[data-part=checkbox-checked]",
        "selector": ".Polaris-Checkbox__Backdrop",
        "skip": ["edge"]
      }
    }
  },
  "react.html?sheet=navigation&theme=light": {
    "mode": "light",
    "parts": {
      "tab": {
        "within": ".Polaris-Tabs__Wrapper",
        "selector": ".Polaris-Tabs__Tab:not(.Polaris-Tabs__Tab--active)",
        "ink": ".Polaris-Text--root",
        "only": [
          "color",
          "borderRadius",
          "height",
          "paddingInline",
          "fontSize",
          "fontWeight",
          "edge"
        ]
      },
      "tab.selected": {
        "within": ".Polaris-Tabs__Wrapper",
        "selector": ".Polaris-Tabs__Tab--active",
        "ink": ".Polaris-Text--root",
        "skip": ["fontFamily", "letterSpacing", "boxShadow"]
      },
      "link": {
        "within": "[data-part=link]",
        "selector": "a"
      },
      "shell": {
        "selector": ".Polaris-Navigation",
        "skip": ["edge"]
      },
      "panel": {
        "selector": ".Polaris-Frame",
        "skip": ["edge"]
      },
      "nav.item": {
        "selector": ".Polaris-Navigation__ItemInnerWrapper:not(.Polaris-Navigation__ItemInnerWrapper--selected)",
        "ink": ".Polaris-Text--root",
        "skip": ["paddingInline"]
      },
      "nav.item.active": {
        "selector": ".Polaris-Navigation__ItemInnerWrapper--selected",
        "ink": ".Polaris-Text--root",
        "skip": ["paddingInline"]
      }
    }
  },
  "react.html?sheet=menu&theme=light": {
    "mode": "light",
    "parts": {
      "menu": {
        "selector": ".Polaris-Popover__ContentContainer",
        "surface": true,
        "skip": ["color", "boxShadow"]
      },
      "menu.item": {
        "selector": ".Polaris-ActionList__Item",
        "ink": ".Polaris-Text--root",
        "skip": ["backgroundColor", "paddingInline"]
      },
      "tooltip": {
        "selector": ".Polaris-Tooltip-TooltipOverlay__Content",
        "ink": ".Polaris-Text--root",
        "skip": ["boxShadow"]
      }
    }
  },
  "react.html?sheet=dialog&theme=light": {
    "mode": "light",
    "parts": {
      "dialog": {
        "selector": ".Polaris-Modal-Dialog__Modal",
        "skip": ["color", "boxShadow"]
      }
    }
  },
  "react.html?sheet=display&theme=light": {
    "mode": "light",
    "parts": {
      "card": {
        "within": "[data-part=card]",
        "selector": ".Polaris-ShadowBevel",
        "box": "::before",
        "skip": ["backgroundColor", "color"]
      }
    }
  },
  "react.html?sheet=feedback&theme=light": {
    "mode": "light",
    "parts": {
      "badge": {
        "within": "[data-part=badge]",
        "selector": ".Polaris-Badge",
        "ink": ".Polaris-Text--root",
        "skip": ["fontFamily", "letterSpacing", "boxShadow"]
      }
    }
  },
  "react.html?sheet=type&theme=light": {
    "mode": "light",
    "parts": {
      "heading.1": {
        "within": "[data-part=heading-3xl]",
        "selector": "h1",
        "skip": ["fontFamily"]
      },
      "heading.2": {
        "within": "[data-part=heading-2xl]",
        "selector": "h1",
        "skip": ["fontFamily"]
      },
      "heading.3": {
        "within": "[data-part=heading-xl]",
        "selector": "h2",
        "skip": ["fontFamily"]
      },
      "heading.4": {
        "within": "[data-part=heading-lg]",
        "selector": "h3",
        "skip": ["fontFamily"]
      },
      "text": {
        "within": "[data-part=text]",
        "selector": "p",
        "skip": ["fontFamily", "fontSize", "letterSpacing"]
      },
      "text.muted": {
        "within": "[data-part=text-muted]",
        "selector": "p",
        "only": ["color"]
      }
    }
  },
  "react.html?sheet=actions&theme=dark": {
    "mode": "dark",
    "parts": {
      "page": {
        "selector": "body",
        "skip": ["fontFamily"]
      },
      "button.primary": {
        "within": "[data-part=button-primary]",
        "selector": "button",
        "ink": ".Polaris-Text--root",
        "only": ["backgroundColor", "color"]
      },
      "button.secondary": {
        "within": "[data-part=button-secondary]",
        "selector": "button",
        "ink": ".Polaris-Text--root",
        "only": ["backgroundColor", "color"]
      },
      "button.quiet": {
        "within": "[data-part=button-quiet]",
        "selector": "button",
        "ink": ".Polaris-Text--root",
        "only": ["color"]
      }
    }
  },
  "react.html?sheet=selection&theme=dark": {
    "mode": "dark",
    "parts": {
      "checkbox.checked": {
        "within": "[data-part=checkbox-checked]",
        "selector": ".Polaris-Checkbox__Backdrop",
        "skip": ["borderRadius", "height", "edge"]
      }
    }
  },
  "react.html?sheet=navigation&theme=dark": {
    "mode": "dark",
    "parts": {
      "tab.selected": {
        "within": ".Polaris-Tabs__Wrapper",
        "selector": ".Polaris-Tabs__Tab--active",
        "ink": ".Polaris-Text--root",
        "only": ["backgroundColor", "color"]
      }
    }
  },
  "react.html?sheet=menu&theme=dark": {
    "mode": "dark",
    "parts": {
      "menu": {
        "selector": ".Polaris-Popover__ContentContainer",
        "surface": true,
        "only": ["backgroundColor"]
      },
      "tooltip": {
        "selector": ".Polaris-Tooltip-TooltipOverlay__Content",
        "ink": ".Polaris-Text--root",
        "only": ["backgroundColor", "color"]
      }
    }
  },
  "react.html?sheet=dialog&theme=dark": {
    "mode": "dark",
    "parts": {
      "dialog": {
        "selector": ".Polaris-Modal-Dialog__Modal",
        "only": ["backgroundColor"]
      }
    }
  },
  "react.html?sheet=display&theme=dark": {
    "mode": "dark",
    "parts": {
      "card": {
        "within": "[data-part=card]",
        "selector": ".Polaris-ShadowBevel",
        "only": ["backgroundColor"]
      }
    }
  },
  "react.html?sheet=type&theme=dark": {
    "mode": "dark",
    "parts": {
      "heading.1": {
        "within": "[data-part=heading-3xl]",
        "selector": "h1",
        "only": ["color"]
      },
      "heading.2": {
        "within": "[data-part=heading-2xl]",
        "selector": "h1",
        "only": ["color"]
      },
      "heading.3": {
        "within": "[data-part=heading-xl]",
        "selector": "h2",
        "only": ["color"]
      },
      "heading.4": {
        "within": "[data-part=heading-lg]",
        "selector": "h3",
        "only": ["color"]
      },
      "text": {
        "within": "[data-part=text]",
        "selector": "p",
        "only": ["color"]
      },
      "text.muted": {
        "within": "[data-part=text-muted]",
        "selector": "p",
        "only": ["color"]
      }
    }
  },
  "web.html": {
    "mode": "light",
    "parts": {
      "switch.on": {
        "selector": "[data-part=switch-on] s-switch >>> input"
      },
      "switch.off": {
        "selector": "[data-part=switch] s-switch >>> input"
      }
    }
  }
}
