{
  "react.html?sheet=actions&theme=light": {
    "mode": "light",
    "parts": {
      "page": {
        "selector": "body"
      },
      "button.primary": {
        "within": "[data-part=button-primary]",
        "selector": "button",
        "ink": ".Polaris-Text--root",
        "skip": ["letterSpacing"]
      },
      "button.secondary": {
        "within": "[data-part=button-secondary]",
        "selector": "button",
        "ink": ".Polaris-Text--root",
        "skip": ["letterSpacing"]
      },
      "button.quiet": {
        "within": "[data-part=button-quiet]",
        "selector": "button",
        "ink": ".Polaris-Text--root",
        "only": [
          "color",
          "borderRadius",
          "height",
          "paddingInline",
          "fontSize",
          "fontWeight",
          "edge"
        ]
      },
      "button.focus": {
        "within": "[data-part=button-focus]",
        "selector": "button",
        "focus": true,
        "only": ["ring"]
      },
      "kbd": {
        "within": "[data-part=kbd-small]",
        "selector": ".Polaris-KeyboardKey",
        "skip": ["letterSpacing", "boxShadow"]
      },
      "button.icon": {
        "within": "[data-part=button-icon]",
        "selector": "button"
      },
      "segmented": {
        "within": "[data-part=segmented]",
        "selector": ".Polaris-ButtonGroup",
        "skip": ["borderRadius"]
      },
      "segmented.item": {
        "within": "[data-part=segmented]",
        "selector": "button:not([aria-pressed=true])",
        "ink": ".Polaris-Text--root",
        "skip": ["letterSpacing"]
      },
      "segmented.selected": {
        "within": "[data-part=segmented]",
        "selector": "button[aria-pressed=true]",
        "ink": ".Polaris-Text--root",
        "skip": ["letterSpacing"]
      }
    }
  },
  "react.html?sheet=fields&theme=light": {
    "mode": "light",
    "parts": {
      "input": {
        "within": "[data-part=input]",
        "selector": ".Polaris-TextField",
        "box": ".Polaris-TextField__Backdrop",
        "ink": "input",
        "only": [
          "backgroundColor",
          "color",
          "borderRadius",
          "height",
          "fontSize",
          "fontWeight",
          "edge"
        ]
      },
      "input.focus": {
        "selector": "[data-specimen-focus]",
        "only": ["backgroundColor", "edge", "ring"],
        "focus": true
      },
      "select.trigger": {
        "within": "[data-part=select]",
        "selector": ".Polaris-Select",
        "box": ".Polaris-Select__Backdrop",
        "ink": ".Polaris-Select__SelectedOption",
        "only": [
          "backgroundColor",
          "color",
          "borderRadius",
          "height",
          "fontSize",
          "fontWeight",
          "edge"
        ]
      },
      "field.label": {
        "within": "[data-part=input]",
        "selector": ".Polaris-Label__Text .Polaris-Text--root"
      }
    }
  },
  "react.html?sheet=selection&theme=light": {
    "mode": "light",
    "parts": {
      "checkbox": {
        "within": "[data-part=checkbox]",
        "selector": ".Polaris-Checkbox__Backdrop"
      },
      "checkbox.checked": {
        "within": "[data-part=checkbox-checked]",
        "selector": ".Polaris-Checkbox__Backdrop"
      },
      "radio": {
        "within": "[data-part=radio]",
        "selector": ".Polaris-RadioButton__Backdrop"
      },
      "radio.checked": {
        "within": "[data-part=radio-checked]",
        "selector": ".Polaris-RadioButton__Backdrop"
      }
    }
  },
  "react.html?sheet=navigation&theme=light": {
    "mode": "light",
    "parts": {
      "tab": {
        "within": ".Polaris-Tabs__Wrapper",
        "selector": ".Polaris-Tabs__Tab:not(.Polaris-Tabs__Tab--active)",
        "ink": ".Polaris-Text--root",
        "only": [
          "color",
          "borderRadius",
          "height",
          "paddingInline",
          "fontSize",
          "fontWeight",
          "edge"
        ]
      },
      "tab.selected": {
        "within": ".Polaris-Tabs__Wrapper",
        "selector": ".Polaris-Tabs__Tab--active",
        "ink": ".Polaris-Text--root",
        "skip": ["fontFamily", "letterSpacing", "boxShadow"]
      },
      "link": {
        "within": "[data-part=link]",
        "selector": "a"
      },
      "shell": {
        "selector": ".Polaris-Navigation"
      },
      "panel": {
        "selector": ".Polaris-Frame"
      },
      "nav.item": {
        "selector": ".Polaris-Navigation__ItemInnerWrapper:not(.Polaris-Navigation__ItemInnerWrapper--selected)",
        "ink": ".Polaris-Text--root",
        "skip": ["paddingInline"]
      },
      "nav.item.active": {
        "selector": ".Polaris-Navigation__ItemInnerWrapper--selected",
        "ink": ".Polaris-Text--root",
        "skip": ["paddingInline"]
      }
    }
  },
  "react.html?sheet=menu&theme=light": {
    "mode": "light",
    "parts": {
      "menu": {
        "selector": ".Polaris-Popover__ContentContainer",
        "surface": true,
        "skip": ["color", "boxShadow"]
      },
      "menu.item": {
        "selector": ".Polaris-ActionList__Item",
        "ink": ".Polaris-Text--root",
        "skip": ["backgroundColor", "paddingInline"]
      },
      "tooltip": {
        "selector": ".Polaris-Tooltip-TooltipOverlay__Content",
        "ink": ".Polaris-Text--root",
        "skip": ["boxShadow"]
      }
    }
  },
  "react.html?sheet=dialog&theme=light": {
    "mode": "light",
    "parts": {
      "dialog": {
        "selector": ".Polaris-Modal-Dialog__Modal",
        "skip": ["color", "boxShadow"]
      }
    }
  },
  "react.html?sheet=display&theme=light": {
    "mode": "light",
    "parts": {
      "card": {
        "within": "[data-part=card]",
        "selector": ".Polaris-ShadowBevel",
        "box": "::before",
        "skip": ["backgroundColor", "color"]
      }
    }
  },
  "react.html?sheet=dates&theme=light": {
    "mode": "light",
    "parts": {
      "calendar.day": {
        "within": "[data-part=calendar]",
        "selector": ".Polaris-DatePicker__Day:not(.Polaris-DatePicker__Day--selected):not([aria-label^=Today])",
        "ink": ".Polaris-Text--root",
        "skip": ["backgroundColor"]
      },
      "calendar.today": {
        "within": "[data-part=calendar]",
        "selector": ".Polaris-DatePicker__Day[aria-label^=Today]",
        "ink": ".Polaris-Text--root",
        "skip": ["backgroundColor"]
      },
      "calendar.selected": {
        "within": "[data-part=calendar]",
        "selector": ".Polaris-DatePicker__Day--selected",
        "ink": ".Polaris-Text--root"
      }
    }
  },
  "react.html?sheet=feedback&theme=light": {
    "mode": "light",
    "parts": {
      "badge": {
        "within": "[data-part=badge]",
        "selector": ".Polaris-Badge",
        "ink": ".Polaris-Text--root",
        "skip": ["letterSpacing", "boxShadow"]
      },
      "alert": {
        "within": "[data-part=banner-info]",
        "selector": ".Polaris-Banner"
      },
      "progress": {
        "within": "[data-part=progress]",
        "selector": ".Polaris-ProgressBar"
      },
      "progress.fill": {
        "within": "[data-part=progress]",
        "selector": ".Polaris-ProgressBar__Indicator"
      }
    }
  },
  "react.html?sheet=type&theme=light": {
    "mode": "light",
    "parts": {
      "heading.1": {
        "within": "[data-part=heading-3xl]",
        "selector": "h1"
      },
      "heading.2": {
        "within": "[data-part=heading-2xl]",
        "selector": "h1"
      },
      "heading.3": {
        "within": "[data-part=heading-xl]",
        "selector": "h2"
      },
      "heading.4": {
        "within": "[data-part=heading-lg]",
        "selector": "h3"
      },
      "text": {
        "within": "[data-part=text]",
        "selector": "p",
        "skip": ["fontSize", "letterSpacing"]
      },
      "text.muted": {
        "within": "[data-part=text-muted]",
        "selector": "p",
        "only": ["color"]
      }
    }
  },
  "react.html?sheet=actions&theme=dark": {
    "mode": "dark",
    "parts": {
      "page": {
        "selector": "body"
      },
      "button.primary": {
