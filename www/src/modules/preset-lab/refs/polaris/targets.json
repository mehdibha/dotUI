        "ink": ".Polaris-Text--root",
        "only": [
          "color",
          "borderRadius",
          "height",
          "paddingInline",
          "fontSize",
          "fontWeight",
          "edge"
        ]
      },
      "tab.selected": {
        "selector": ".Polaris-Tabs__Tab--active",
        "ink": ".Polaris-Text--root",
        "skip": ["fontFamily", "letterSpacing", "boxShadow"]
      },
      "badge": {
        "selector": ".Polaris-Badge:not([class*=Badge--tone])",
        "ink": ".Polaris-Text--root",
        "skip": ["letterSpacing", "boxShadow"]
      },
      "shell": {
