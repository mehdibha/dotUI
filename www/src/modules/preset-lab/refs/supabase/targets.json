{
  "https://supabase.com/design-system/docs/components/button": {
    "parts": {
      "button.primary": {
        "selector": ".preview button[class~=\"bg-primary-solid\"]"
      },
      "button.secondary": {
        "selector": ".preview button",
        "text": "Button rest"
      },
      "button.quiet": {
        "selector": ".preview button[class~=\"hover:bg-accent\"]"
      },
      "button.focus": {
        "selector": ".preview button[class~=\"bg-primary-solid\"]",
        "focus": true
      },
      "button.icon": {
        "selector": ".preview button[aria-label=\"More actions\"]",
        "skip": ["borderRadius"]
      }
    }
  },
  "https://supabase.com/design-system/docs/components/input": {
    "parts": {
      "input": {
        "selector": ".preview input[type=email]"
      },
      "input.focus": {
        "selector": ".preview input[type=email]",
        "focus": true
      }
    }
  },
  "https://supabase.com/design-system/docs/components/select": {
    "parts": {
      "select.trigger": {
        "selector": ".preview button[role=combobox]",
        "skip": ["color"]
      },
      "link": {
        "selector": ".preview a",
        "text": "email settings"
      }
    }
  },
  "https://supabase.com/design-system/docs/components/checkbox": {
    "parts": {
      "checkbox": {
        "selector": ".preview button[role=checkbox][data-state=unchecked]"
      },
      "checkbox.checked": {
        "selector": ".preview button[role=checkbox][data-state=checked]",
        "skip": ["edge"]
      }
    }
  },
  "https://supabase.com/design-system/docs/components/switch": {
    "parts": {
      "switch.off": {
        "selector": ".preview button[role=switch][data-state=unchecked]"
      },
      "switch.on": {
        "selector": ".preview button[role=switch][data-state=checked]"
      }
    }
  },
  "https://supabase.com/design-system/docs/components/tabs": {
    "parts": {
      "tab": {
        "selector": ".preview [role=tab][data-state=inactive]",
        "skip": ["borderRadius", "boxShadow", "paddingInline"]
      },
      "tab.selected": {
        "selector": ".preview [role=tab][data-state=active]",
        "skip": ["borderRadius", "boxShadow", "paddingInline"]
      }
    }
  },
  "https://supabase.com/design-system/docs/components/sidebar": {
    "parts": {
      "shell": {
        "selector": ".preview [data-sidebar=sidebar]"
      },
      "panel": {
        "selector": ".preview main"
      },
      "nav.item": {
        "selector": ".preview [data-sidebar=menu-button][data-active=false]"
      },
      "nav.item.active": {
        "selector": ".preview [data-sidebar=menu-button][data-active=true]"
      }
    }
  },
  "https://supabase.com/design-system/docs/components/dropdown-menu": {
    "parts": {
      "menu": {
        "selector": "[role=menu]",
        "surface": true,
        "before": [
          {
            "click": ".preview button::-p-text(Open)"
          }
        ],
        "skip": ["color"]
      },
      "menu.item": {
        "selector": "[role=menu] [role=menuitem]",
        "nth": 1,
        "before": [
          {
            "click": ".preview button::-p-text(Open)"
          }
        ],
        "skip": ["paddingInline"]
      }
    }
  },
  "https://supabase.com/design-system/docs/components/tooltip": {
    "parts": {
      "tooltip": {
        "selector": "[data-radix-popper-content-wrapper] > *",
        "surface": true,
        "before": [
          {
            "hover": ".preview button::-p-text(Hover)"
          }
        ]
      }
    }
  },
  "https://supabase.com/design-system/docs/components/dialog": {
    "parts": {
      "dialog": {
        "selector": "[role=dialog]",
        "surface": true,
        "before": [
          {
            "click": ".preview button::-p-text(Edit profile)"
          }
        ],
        "skip": ["color"]
      }
    }
  },
  "https://supabase.com/design-system/docs/components/commandmenu": {
    "parts": {
      "command": {
        "selector": "[role=dialog]",
        "surface": true,
        "before": [
          {
            "click": ".preview button::-p-text(Open command menu)"
          }
        ],
        "skip": ["color"]
      },
      "command.item": {
        "selector": "[role=dialog] [role=option]",
        "nth": 1,
        "before": [
          {
            "click": ".preview button::-p-text(Open command menu)"
          }
        ],
        "skip": ["paddingInline"]
      }
    }
  },
  "https://supabase.com/design-system/docs/components/badge": {
    "parts": {
      "badge": {
        "selector": ".preview > div",
        "text": "Default"
      },
      "badge.accent": {
        "selector": ".preview div",
        "text": "Success"
      }
    }
  },
  "https://supabase.com/design-system/docs/components/toggle": {
    "parts": {
      "toggle": {
        "selector": ".preview button[aria-label=\"Toggle bold\"]"
      },
      "toggle.on": {
        "selector": ".preview button[data-state=on]",
        "before": [
          {
            "click": ".preview button[aria-label=\"Toggle bold\"]"
          },
          {
            "hover": "main h1"
          }
        ]
      }
    }
  },
  "https://supabase.com/design-system/docs/components/toggle-group": {
    "parts": {
      "segmented": {
        "selector": "[aria-label=\"Filter keys by status (tiny)\"]"
      },
      "segmented.item": {
        "within": "[aria-label=\"Filter keys by status (tiny)\"]",
        "selector": "[role=radio][data-state=off]"
      },
      "segmented.selected": {
        "selector": "[aria-label=\"Filter keys by status (tiny)\"]",
        "box": "[data-segment-indicator]",
        "ink": "[role=radio][data-state=on]",
        "skip": ["paddingInline"]
      }
    }
  },
  "https://supabase.com/design-system/docs/components/radio-group": {
    "parts": {
      "radio": {
        "selector": ".preview button[role=radio][data-state=unchecked]"
      },
      "radio.checked": {
        "selector": ".preview button[role=radio][data-state=checked]"
      }
    }
  },
  "https://supabase.com/design-system/docs/components/progress": {
    "parts": {
      "progress": {
        "selector": ".preview [role=progressbar]"
      },
      "progress.fill": {
        "selector": ".preview [role=progressbar] > div",
        "skip": ["borderRadius"]
      }
    }
  },
  "https://supabase.com/design-system/docs/components/alert": {
    "parts": {
      "alert": {
        "selector": ".preview [role=alert]"
      }
    }
  },
  "https://supabase.com/design-system/docs/components/calendar": {
    "parts": {
      "calendar.day": {
        "selector": ".preview td[data-day]:not([data-outside], [data-today], [data-selected], [data-disabled]) button"
      },
      "calendar.selected": {
        "selector": ".preview td[data-selected]:not([data-today])"
      }
    }
  },
  "https://supabase.com/design-system/docs/components/form": {
    "parts": {
      "field.label": {
        "selector": ".preview label"
      }
    }
  },
  "https://supabase.com/design-system/docs/fragments/metric-card": {
    "parts": {
      "card": {
        "selector": ".preview div[class~=\"bg-surface-100\"]",
        "skip": ["color"]
      }
    }
  },
  "https://supabase.com/design-system/docs/typography": {
    "parts": {
      "heading.1": {
        "selector": "main h1",
        "skip": ["fontSize"]
      },
      "text": {
        "selector": "main .mdx p",
        "skip": ["fontSize"]
      }
    }
  }
}
