{
  "https://linear.app/<ws>/settings/account/preferences": {
    "signedIn": true,
    "parts": {
      "page": {
        "selector": "main"
      },
      "panel": {
        "selector": "main"
      },
      "shell": {
        "selector": "html"
      },
      "heading.3": {
        "selector": "main span",
        "text": "Preferences"
      },
      "text.muted": {
        "selector": "main section li span",
        "nth": 1,
        "skip": ["fontSize"]
      },
      "select.trigger": {
        "selector": "main button[role=combobox][data-select-variant=default]"
      },
      "switch.on": {
        "selector": "main input[type=checkbox]",
        "nth": 0
      },
      "switch.off": {
        "selector": "main input[type=checkbox]",
        "nth": 1
      },
      "card": {
        "selector": "main section"
      },
      "button.quiet": {
        "selector": "main button[aria-label=\"Customize sidebar\"]"
      },
      "button.focus": {
        "selector": "main button[aria-label=\"Customize sidebar\"]",
        "focus": true
      },
      "menu": {
        "selector": "[role=listbox]",
        "surface": true,
        "before": [
          {
            "click": "main button[role=combobox][data-select-variant=default]"
          }
        ]
      },
      "menu.item": {
        "selector": "[role=listbox] [role=option]",
        "nth": 1,
        "box": "::before",
        "ink": ":scope > span",
        "skip": ["paddingInline"],
        "before": [
          {
            "click": "main button[role=combobox][data-select-variant=default]"
          }
        ]
      }
    }
  },
  "https://linear.app/<ws>/settings/account/profile": {
    "signedIn": true,
    "parts": {
      "input": {
        "selector": "main input#title"
      },
      "input.focus": {
        "selector": "main input#title",
        "focus": true
      },
      "field.label": {
        "selector": "main label"
      }
    }
  },
  "https://linear.app/<ws>/settings/security": {
    "signedIn": true,
    "parts": {
      "button.secondary": {
        "selector": "main button",
        "text": "Copy"
      },
      "link": {
        "selector": "main a[href^=\"http\"]",
        "text": "Docs"
      }
    }
  },
  "https://linear.app/<ws>/settings/issue-labels": {
    "signedIn": true,
    "parts": {
      "button.primary": {
        "selector": "main button",
        "text": "New label"
      }
    }
  },
  "https://linear.app/<ws>/inbox": {
    "signedIn": true,
    "parts": {
      "nav.item": {
        "selector": "a[href*=\"/my-issues\"] > span"
      },
      "nav.item.active": {
        "selector": "a[data-active=true] > span",
        "ink": ":scope > div > span"
      },
      "tooltip": {
        "text": "Create new issue",
        "surface": true,
        "ink": ":scope > div > div",
        "skip": ["paddingInline"],
        "before": [
          {
            "hover": "[aria-label=\"Create new issue\"]"
          }
        ]
      },
      "dialog": {
        "selector": "[role=dialog][aria-label=\"Create issue\"] div",
        "surface": true,
        "before": [
          {
            "press": "c"
          }
        ]
      },
      "command": {
        "selector": "input[aria-label=\"Command menu\"]",
        "surface": true,
        "before": [
          {
            "press": "Meta+k"
          }
        ]
      },
      "command.item": {
        "selector": "[role=listbox] [role=option][data-focused=false]",
        "box": "::before",
        "ink": ":scope > div > div > span",
        "before": [
          {
            "press": "Meta+k"
          }
        ]
      },
      "kbd": {
        "selector": "[role=listbox] [role=option] kbd",
        "before": [
          {
            "press": "Meta+k"
          }
        ]
      },
      "button.icon": {
        "selector": "[aria-label=\"Create new issue\"]"
      }
    }
  },
  "https://linear.app/<ws>/my-issues/assigned": {
    "signedIn": true,
    "parts": {
      "tab": {
        "selector": "main a",
        "text": "Created"
      },
      "tab.selected": {
        "selector": "main a",
        "text": "Assigned"
      }
    }
  },
  "https://linear.app/<ws>/my-issues/created": {
    "signedIn": true,
    "parts": {
      "checkbox": {
        "selector": "main div:has(> input[type=checkbox])",
        "before": [
          {
            "hover": "main a[href*=\"/issue/\"]"
          }
        ]
      }
    }
  }
}
