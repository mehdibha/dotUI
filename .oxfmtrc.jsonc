{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      {
        "groupName": "react-libs",
        "elementNamePattern": [
          "react",
          "react/**",
          "react-dom",
          "react-dom/**",
        ],
      },
      // Framework pin (shadcn pins `next` the same way).
      {
        "groupName": "tanstack-libs",
        "elementNamePattern": ["@tanstack/**"],
      },
      {
        "groupName": "dotui-libs",
        "elementNamePattern": ["@dotui/**"],
      },
      // Layered internal imports (shadcn-style): low-level → high-level.
      {
        "groupName": "internal-types",
        "elementNamePattern": ["@/types", "@/types/**"],
      },
      {
        "groupName": "internal-config",
        "elementNamePattern": ["@/config", "@/config/**"],
      },
      {
        "groupName": "internal-lib",
        "elementNamePattern": ["@/lib", "@/lib/**"],
      },
      {
        "groupName": "internal-hooks",
        "elementNamePattern": ["@/hooks", "@/hooks/**"],
      },
      {
        "groupName": "internal-registry",
        "elementNamePattern": ["@/registry", "@/registry/**"],
      },
      {
        "groupName": "internal-publisher",
        "elementNamePattern": ["@/publisher", "@/publisher/**"],
      },
      {
        "groupName": "internal-components",
        "elementNamePattern": ["@/components", "@/components/**"],
      },
      {
        "groupName": "internal-modules",
        "elementNamePattern": ["@/modules", "@/modules/**"],
      },
    ],
    "groups": [
      ["side_effect", "side_effect_style"],
      { "newlinesBetween": true },
      "react-libs",
      "tanstack-libs",
      "builtin",
      "external",
      { "newlinesBetween": true },
      "dotui-libs",
      { "newlinesBetween": true },
      "internal-types",
      "internal-config",
      "internal-lib",
      "internal-hooks",
      "internal-registry",
      "internal-publisher",
      "internal-components",
      "internal-modules",
      "internal",
      { "newlinesBetween": true },
      ["parent", "sibling", "index"],
      "style",
      "unknown",
    ],
  },
  "sortTailwindcss": {
    "stylesheet": "www/src/styles.css",
    "attributes": ["classList"],
    "functions": ["cn", "tv", "createStyles"],
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.pnpm-store/**",
    "**/.cache/**",
    "**/dist/**",
    "**/build/**",
    "**/.turbo/**",
    "**/.nitro/**",
    "**/.output/**",
    "**/.source/**",
    "www/src/routeTree.gen.ts",
    "directory/src/routeTree.gen.ts",
    // Written by presets:looks and presets:spec from a capture.
    "directory/systems/*/looks.json",
    "directory/systems/*/spec.json",
    // Extractor-owned, byte-deterministic from directory/'s pipeline.
    "directory/systems/*/colors.json",
    // Upstream files snapshotted byte for byte; the manifest hashes them.
    "directory/sources/**",
    // examples/: what the shadcn CLI writes during the consumer smoke — the
    // registry's output, committed verbatim (its own formatting pass applies).
    "examples/*/src/routeTree.gen.ts",
    "examples/*/src/components/ui/**",
    "examples/*/src/hooks/**",
    "examples/*/src/lib/**",
    "examples/*/components.json",
    // pnpm writes minimumReleaseAgeExclude here during the smoke install.
    "examples/*/pnpm-workspace.yaml",
    "examples/*/src/app/globals.css",
    "examples/*/src/app/layout.tsx",
    "examples/*/src/styles.css",
    "examples/*/.next/**",
    "examples/*/next-env.d.ts",
    // Generated by registry-build — formatting would fight the drift check.
    "**/__generated__/**",
    // Written by presets:crawl, one look per line.
    "packages/capture/refs/*/model.json",
    "www/src/registry/base/colors.css",
    "www/src/registry/base/theme.css",
    "docs/**",
  ],
}
