{
  "version": 1,
  "slug": "higgsfield",
  "sections": {
    "color": {
      "status": "reviewed",
      "summary": "Dark only. Pages are #131416, raised panels #1e2124 and #23262a; text is white or #f7f7f8 with #898a8b for quiet labels. The one accent is a lime #d1fe17 under near-black #1a1a1a ink, on the main action, the current nav item and the Premium tag. Its soft form is a dark olive tint (#262b15) with lime text.",
      "usage": [
        "Glass surfaces (menus, the dialog, some buttons) are translucent fills blurred 40px with a 1px ring of white at 5%.",
        "There is no light theme: the app's light rules only cover code blocks and a separate builder."
      ]
    },
    "type": {
      "status": "reviewed",
      "summary": "Inter: 14px at 500 with 0.1px tracking for menus, nav and buttons, 16/24 for body text, 12/16 at 500 for labels and tags. Marketing headlines use heavy uppercase display type; small eyebrow labels are monospace at 11px with wide tracking."
    },
    "shape": {
      "status": "reviewed",
      "summary": "8px corners on menu rows and small controls, 10 to 12px on buttons, cards and menus, 24px on the sign-up dialog. Tags and chips are pills."
    },
    "spacing": {
      "status": "reviewed",
      "summary": "Compact controls on a 4px step: buttons 40px (sm) and 48px (md) with 16px padding, menu rows 36px with 8px, header pills 36px with 12px. Tags are 16px tall with 4px padding."
    },
    "elevation": {
      "status": "reviewed",
      "summary": "Depth comes from fills and inner highlights more than shadows: a 0 1.5px 3px white-at-5% inset on dark pills, a 0 2px 3px black-at-15% inset on tiles, a 1px white-at-5% ring on menus. Marketing buttons add a 3px darker inset along the bottom edge."
    },
