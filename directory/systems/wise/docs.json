{
  "version": 1,
  "slug": "wise",
  "blocks": {
    "color": {
      "status": "reviewed",
      "summary": "Neptune pairs a forest green with a bright green. Light pages are white with #0e0f0c titles and #454745 body text; forest #163300 is the ink for links, labels on green, checks and focus; bright green #9fe870 fills the primary button. Control edges are #868685. Dark mode moves to #121511 pages and #1e211d raised surfaces, and swaps the roles: bright green becomes the link, check and focus color, still with forest labels on the primary button.",
      "usage": [
        "Status colors come in pairs, a strong ink over a pale fill: negative #cb272f on #fbeaea, positive #054d28 on #e2f6d5, warning #ffd11a with a #fff7d7 prompt.",
        "Neutral fills are forest at 8% (#16330014), which reads as a faint green-grey."
      ]
    },
    "type": {
      "status": "reviewed",
      "summary": "Inter for all UI with a slight negative tracking: 16/24 for fields, options and button labels (600 on buttons), 14/21.7 for body text and labels. Tags are 12px at 600. Display headlines on wise.com use Wise Sans, a heavy condensed face."
    },
    "shape": {
      "status": "reviewed",
      "summary": "Pills for buttons, chips and the segmented control; 10px corners on fields and menus, 16px on tooltips, prompts and cards, 32px on modals. Tags are 6px."
    },
    "spacing": {
      "status": "reviewed",
      "summary": "Roomy, on a 4px step: buttons, fields and list rows are 48px with 16px inline padding; chips and medium buttons 32 to 40px. Gaps are mostly 12 and 16px."
    },
    "elevation": {
      "status": "reviewed",
      "summary": "Almost no shadows. Menus, the command popover and tooltips float on one soft halo, 0 0 40px of #454745 at 20%; modals have none. Field edges are 1px inset shadows that thicken to 3px forest on focus, with no outer ring."
    },
