    {
      "component": "button",
      "name": "Button",
      "docsUrl": "https://chakra-ui.com/docs/components/button",
      "demo": {
        "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>Chakra UI Button</title>\n<script>\n  (function () {\n    var el = document.documentElement;\n    var listeners = [];\n    var dark = false;\n\n    // The whole dark mechanism, idempotent and two-way.\n    function applyMode(next) {\n      dark = !!next;\n      if (dark) el.classList.add(\"dark\");\n      else el.classList.remove(\"dark\");\n      for (var i = 0; i < listeners.length; i++) listeners[i](dark);\n    }\n\n    window.__demoMode = {\n      isDark: function () { return dark; },\n      subscribe: function (fn) { listeners.push(fn); fn(dark); }\n    };\n\n    // 1. Explicit ?mode= override: apply once, never observe.\n    var param = new URLSearchParams(window.location.search).get(\"mode\");\n    if (param !== null) {\n      applyMode(param === \"dark\");\n      return;\n    }\n\n    // 2. Otherwise mirror the embedding parent's <html> class, live.\n    var root = null;\n    try {\n      if (window.parent !== window) root = window.parent.document.documentElement;\n    } catch (err) {\n      root = null;\n    }\n    if (!root) {\n      applyMode(false);\n      return;\n    }\n    applyMode(root.classList.contains(\"dark\"));\n    var observer = new MutationObserver(function () {\n      applyMode(root.classList.contains(\"dark\"));\n    });\n    observer.observe(root, { attributes: true, attributeFilter: [\"class\"] });\n    window.__demoModeObserver = observer;\n  })();\n</script>\n<style>\n  html, body { margin: 0; padding: 0; background: #ffffff; }\n  html.dark, html.dark body { background: var(--chakra-colors-bg, #09090B); }\n  #root { min-height: 100vh; }\n</style>\n<script type=\"importmap\">\n{\n  \"imports\": {\n    \"react\": \"https://esm.sh/react@19.1.0\",\n    \"react/jsx-runtime\": \"https://esm.sh/react@19.1.0/jsx-runtime\",\n    \"react-dom\": \"https://esm.sh/react-dom@19.1.0?deps=react@19.1.0\",\n    \"react-dom/client\": \"https://esm.sh/react-dom@19.1.0/client?deps=react@19.1.0\",\n    \"@emotion/react\": \"https://esm.sh/@emotion/react@11.14.0?deps=react@19.1.0\",\n    \"@chakra-ui/react\": \"https://esm.sh/@chakra-ui/react@3.30.0?deps=react@19.1.0,react-dom@19.1.0,@emotion/react@11.14.0\"\n  }\n}\n</script>\n</head>\n<body>\n<div id=\"root\"></div>\n<script type=\"module\">\n  import React from \"react\";\n  import { createRoot } from \"react-dom/client\";\n  import { ChakraProvider, defaultSystem, Button } from \"@chakra-ui/react\";\n\n  const h = React.createElement;\n\n  function Row({ dark }) {\n    return h(\n      \"div\",\n      {\n        style: {\n          minHeight: \"100vh\",\n          boxSizing: \"border-box\",\n          padding: \"16px\",\n          display: \"flex\",\n          alignItems: \"center\",\n          justifyContent: \"center\",\n          gap: \"12px\",\n          flexWrap: \"wrap\",\n          background: dark ? \"var(--chakra-colors-bg, #09090B)\" : \"#ffffff\"\n        }\n      },\n      h(Button, { colorPalette: \"blue\" }, \"Primary\"),\n      h(Button, { colorPalette: \"blue\", variant: \"outline\" }, \"Secondary\"),\n      h(Button, { colorPalette: \"blue\", disabled: true }, \"Disabled\")\n    );\n  }\n\n  const root = createRoot(document.getElementById(\"root\"));\n\n  // Renders now with the resolved mode, and again on every parent change.\n  window.__demoMode.subscribe(function (dark) {\n    root.render(\n      h(ChakraProvider, { value: defaultSystem }, h(Row, { dark: dark }))\n    );\n  });\n</script>\n</body>\n</html>\n",
        "height": 130
      },
