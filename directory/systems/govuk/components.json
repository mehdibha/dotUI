      "docsUrl": "https://design-system.service.gov.uk/components/button/",
      "demo": {
        "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>GOV.UK Design System — Buttons</title>\n<!-- Real published govuk-frontend CSS, pinned to v6.5.0 -->\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/govuk-frontend@6.5.0/dist/govuk/govuk-frontend.min.css\">\n<style>\n  /* Layout only. No component styling: all appearance comes from govuk-frontend.min.css. */\n  html { background: #fff; }\n  body.govuk-template__body {\n    min-height: 100vh;\n    margin: 0;\n    padding: 16px;\n    box-sizing: border-box;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #fff;\n  }\n  .demo-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: center; }\n  /* govuk-frontend makes buttons full-width below its 40.0625em breakpoint and adds a\n     bottom margin for form flow; neutralised here so the demo is a single tight row. */\n  .demo-row .govuk-button { width: auto; margin: 0; }\n</style>\n</head>\n<body class=\"govuk-template__body\">\n  <div class=\"demo-row\">\n    <button type=\"submit\" class=\"govuk-button\" data-module=\"govuk-button\">\n      Save and continue\n    </button>\n    <button type=\"submit\" class=\"govuk-button govuk-button--secondary\" data-module=\"govuk-button\">\n      Secondary button\n    </button>\n    <button type=\"submit\" disabled aria-disabled=\"true\" class=\"govuk-button\" data-module=\"govuk-button\">\n      Disabled button\n    </button>\n  </div>\n</body>\n</html>\n",
        "height": 190
      },
      "note": "Nunjucks/Sass source: packages/govuk-frontend/src/govuk/components/button/ (govuk-frontend v6.5.0)."
