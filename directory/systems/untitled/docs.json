{
  "version": 1,
  "slug": "untitled",
  "sections": {
    "color": {
      "status": "reviewed",
      "summary": "Neutral greys (Tailwind neutral, no tint) on a white page, with one purple brand. Values and headings are #171717, control labels #404040, supporting text #525252. Hairlines are #e5e5e5; control rings #d4d4d4. Brand-600 #7f56d9 fills the primary button, brand-700 #6941c6 colors brand text and #f9f5ff washes selected tabs. Focus rings are #9e77ed. Dark keeps every surface on the #0a0a0a page tone and tells them apart by rings and shadows: #fafafa values, #d4d4d4 labels, #a1a1a1 supporting text.",
      "usage": [
        "Badges come in twelve colors (gray, brand, error, warning, success, slate, sky, blue, indigo, purple, pink, orange), each a pale fill, a darker ring and darker text.",
        "Destructive actions use #e7000b."
      ]
    },
    "type": {
      "status": "reviewed",
      "summary": "Inter throughout. Body text is 16px on 24px; controls, tabs and links are 14px at 600; badges 12px (sm) or 14px (md, lg) at 500. Headings are 600: 18px on 28px, 20px on 30px, and display sizes from 36px carry -2% tracking. The docs set code in the system monospace."
    },
    "shape": {
      "status": "reviewed",
      "summary": "8px corners on buttons, fields, menus and tooltips; 6px on tabs and square badges; pill badges and avatars are round. Cards round to 12px and modals to 16px. Keyboard keys are 4px."
    },
    "spacing": {
      "status": "reviewed",
      "summary": "A 2px grid where 4, 8, 12 and 16px lead. Buttons run xs to xl, 32 to 48px, with 10 to 18px sides; sm (36px, 12px sides) is the default. Fields are 36, 40 or 44px with 12 or 14px sides."
    },
    "elevation": {
      "status": "reviewed",
      "summary": "Controls sit in a 1px inset ring with shadow-xs. Menus take a 10% black ring and shadow-lg; modals and the command palette shadow-xl. Focus is a 2px #9e77ed ring 2px outside (#b692f6 in dark); disabled controls drop to 50% opacity."
    },
