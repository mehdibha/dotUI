{
  "version": 1,
  "slug": "supabase",
  "blocks": {
    "color": {
      "status": "reviewed",
      "summary": "Neutral greys with one green. Light pages are #fdfdfd with near-black #030303 for strong text, #464646 for body copy and #696969 for quiet text; edges run from #e8e8e8 to #d8d8d8. The brand green #0e7e4e fills the primary button and rings the radios. Dark mode is a faintly green grey: #131413 pages, #edefee and #bcbdbc text, #232423 to #303130 edges, and the primary drops to a deep #006338 with green text links in #4acd8b.",
      "usage": [
        "The theme is generated at runtime in OKLCH on hue 157.5: each raised layer steps the surface lightness by about 0.024.",
        "Danger #ab413e and warning #ac5800 fill their buttons with a darker edge of the same hue."
      ]
    },
    "type": {
      "status": "reviewed",
      "summary": "Inter at a 450 regular weight: 13px on an 18.5px line for most of the UI, 12px at 500 on small buttons, 15/22.5 for body copy. Headings switch to Manrope at 600 with tight tracking (22px at -0.55px). Code is Source Code Pro."
    },
    "shape": {
      "status": "reviewed",
      "summary": "6px corners on buttons, fields, cards and toggles in the design-system docs, 4px on menu rows, kbd and checkboxes. The signed-in dashboard rounds the same controls at 8px; the docs read three quarters of that.",
      "usage": ["A few docs buttons (Expand code, Docs) are pills."]
    },
    "spacing": {
      "status": "reviewed",
      "summary": "Compact, on a 4px step: the common button is 26px with 10px padding, fields and select triggers 34px with 12px, menu rows 28px with 8px. Page sections breathe at 24px."
    },
    "elevation": {
      "status": "reviewed",
      "summary": "Mostly flat. Buttons carry a stack of faint inset rings and a 0 1px 3px drop at 4% black; menus, dialogs and list boxes float on a soft shadow at 10%. Focus is a 2px gap in the page color and a 2px mint ring at 55%.",
      "usage": [
        "The primary, danger and warning buttons add a barely visible top-to-bottom gradient over their fill."
      ]
    },
